 "risks": [
  {
   "id": "r-1",
   "title": "Ransomware encrypts patient records and the backup",
   "cause": "Unsupported server; backup disk always connected; vendor remote tool always on",
   "likelihood": 3,
   "impact": 5,
   "treatment": "reduce",
   "actions": "Offline/rotated backup + test restore now; replace server OS; restrict vendor access to on-request with MFA",
   "controls": "PR-10, PR-7, PR-9, RC-1",
   "owner": "Dr. Lim",
   "due": "2026-12-15",
   "status": "open"
  },
  {
   "id": "r-2",
   "title": "Webmail takeover exposes years of lab results",
   "cause": "Shared account, no MFA, password on a card",
   "likelihood": 3,
   "impact": 5,
   "treatment": "reduce",
   "actions": "Business email with individual accounts and MFA; delete old results after retention period",
   "controls": "PR-2, PR-1, PR-11",
   "owner": "Dr. Lim",
   "due": "2026-12-31",
   "status": "open"
  },
  {
   "id": "r-3",
   "title": "Tech-support scam installed remote access",
   "cause": "Staff called a fake support number; PC never checked",
   "likelihood": 3,
   "impact": 4,
   "treatment": "reduce",
   "actions": "Check the reception PC; staff training on support scams",
   "controls": "DE-1, PR-6, DE-4",
   "owner": "Dr. Lim",
   "due": "2026-11-25",
   "status": "open"
  },
  {
   "id": "r-4",
   "title": "Health data shared on personal WhatsApp",
   "cause": "No approved way to send results",
   "likelihood": 4,
   "impact": 4,
   "treatment": "reduce",
   "actions": "Business messaging only; no IC or results on personal phones",
   "controls": "PR-12",
   "owner": "Clinic manager",
   "due": "2027-01-31",
   "status": "open"
  },
  {
   "id": "r-5",
   "title": "Cannot tell who viewed or changed a record",
   "cause": "Shared logins in the clinic system",
   "likelihood": 4,
   "impact": 3,
   "treatment": "reduce",
   "actions": "Individual logins for every staff member and the locum",
   "controls": "PR-1, PR-4",
   "owner": "Dr. Lim",
   "due": "2027-01-31",
   "status": "open"
  },
  {
   "id": "r-6",
   "title": "Missed 72-hour breach notification",
   "cause": "Nobody knows the duty; no plan; DPO not appointed",
   "likelihood": 3,
   "impact": 4,
   "treatment": "reduce",
   "actions": "One-page breach plan; appoint and register a DPO; register the clinic with JPDP",
   "controls": "RS-1, RS-2, GV-1, GV-2",
   "owner": "Dr. Lim",
   "due": "2026-12-31",
   "status": "open"
  }
 ],
