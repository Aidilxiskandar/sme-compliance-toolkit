{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare (Workers static assets). Only the curated dist/
  // folder is published: `npm run build:site` assembles it, including _headers.
  "name": "sme-compliance-toolkit",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
